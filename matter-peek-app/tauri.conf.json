{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "matter-peek",
  "version": "0.1.0",
  "identifier": "com.sysgrok.matterpeek",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "matter-peek",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "url": "matter-peek://localhost/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
